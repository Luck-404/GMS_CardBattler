//===============================================================================//
//
// SCRIPT: SCR_WORLD_EVENT_GET_EVENT_IDS
// FUNCTION: Returns the five equally weighted V1 World Event IDs.
//
// RETURNS: Array of World Event IDs.
//
//===============================================================================//

function scr_world_event_get_event_ids(){

	return [
		"MIGRATION",
		"CHOOSE_A_CHEST",
		"RUNAWAY_TREASURE_BEAST",
		"WANDERING_MERCHANT",
		"ELITE_SIGHTING"
	];
}
