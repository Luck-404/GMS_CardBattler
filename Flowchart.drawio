        <mxCell id="aGVJ742DlCV0qz4ZrSKx-147" value="Create:&lt;br&gt;- overworld state machine&lt;div&gt;- positional variables&lt;/div&gt;&lt;div&gt;- movement variables&lt;/div&gt;&lt;div&gt;- step counts&lt;br&gt;- deck create&lt;br&gt;- party create&lt;br&gt;- blessings create&lt;br&gt;- general stat globals&lt;br&gt;- camera globals&lt;br&gt;- transition/encounter triggered flag&lt;br&gt;- encunter state machine&lt;/div&gt;" style="text;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=7;fillColor=#008a00;fontColor=light-dark(#000000,#FFFFFF);strokeColor=#005700;" parent="aGVJ742DlCV0qz4ZrSKx-146" vertex="1">
